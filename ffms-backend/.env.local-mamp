# Ready-made settings for running everything on your own Mac with MAMP.
# Copy this file to .env (in this same ffms-backend folder):
#     cp .env.local-mamp .env
# Then check DB_PORT matches the MySQL port on MAMP's start page.

DB_HOST=127.0.0.1
DB_PORT=8889
DB_NAME=ffms_db
DB_USER=root
DB_PASS=root
# If connecting by port fails on a Mac, uncomment this line instead:
# DB_SOCKET=/Applications/MAMP/tmp/mysql/mysql.sock

# Both spellings of the local address, so either URL works in the browser.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
FRONTEND_URL=http://localhost:5500

TOKEN_TTL_DAYS=30
VERIFICATION_TTL_HOURS=48
RESET_TTL_MINUTES=60

# No email is sent locally. Verify new accounts with:
#     php tools/verify_user.php you@example.com
RESEND_API_KEY=
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
MAIL_FROM_EMAIL=no-reply@localhost
MAIL_FROM_NAME="John Dhiri Intelligent Farm System"

# Optional: an Anthropic API key makes the farm assistant answer with Claude.
# Leave empty to use the built-in farm knowledge only.
ANTHROPIC_API_KEY=
AI_CHAT_HOURLY_LIMIT=40
