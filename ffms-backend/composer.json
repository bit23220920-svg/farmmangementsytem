{
    "name": "ffms/backend",
    "description": "FFMS — Full Farm Management System, PHP + MySQL backend API",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-mbstring": "*",
        "ext-curl": "*",
        "phpmailer/phpmailer": "^6.9",
        "anthropic-ai/sdk": "^1.4",
        "guzzlehttp/guzzle": "^7"
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "allow-plugins": {
            "php-http/discovery": false
        }
    }
}
